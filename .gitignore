# ============================================
# StreetCore - Git Ignore Configuration
# ============================================
# CRITICAL: Protects secrets and sensitive data

# ==========================================
# SECRETS & ENVIRONMENT VARIABLES (CRITICAL)
# ==========================================
.env
.env.*
!.env.example

# Local environment overrides
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# DATABASES & DATA
# ==========================================
# MongoDB data directories
/data/
/mongo-data/
*.db
*.sqlite

# Database dumps
*.dump
*.sql
*.bak

# ==========================================
# LOGS & TEMPORARY FILES
# ==========================================
# Application logs
/backend/logs/
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# ==========================================
# UPLOADS & MEDIA
# ==========================================
/backend/uploads/
/uploads/
/public/uploads/
/media/

# ==========================================
# DEPENDENCIES
# ==========================================
# Go
/backend/vendor/

# Node.js
node_modules/
npm-debug.log
yarn-error.log
.pnp
.pnp.js

# Dart/Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
build/

