# ========================================
# STREETCORE - Environment Variables Template
# ========================================
# IMPORTANT: Copy this file to .env and fill with real values
# NEVER commit .env files to version control
# ========================================
# Command: cp .env.example .env
# ========================================

# ============================================
# ENVIRONMENT
# ============================================
ENV=development
VERSION=0.2
API_VERSION=v2

# ============================================
# DOMAINS
# ============================================
BASE_URL=http://localhost:3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8080

# ============================================
# MONGODB
# ============================================
# Generate with: openssl rand -base64 32
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=<GENERATE_WITH_OPENSSL>

# Database configuration
DB_NAME=streetcore
DB_APP_USER=streetcore_app
DB_APP_PASS=<GENERATE_WITH_OPENSSL>

# Connection URI (auto-constructed from above)
# Format: mongodb://user:pass@host:port/dbname?authSource=admin
MONGO_URI=mongodb://localhost:27017/streetcore

# ============================================
# SECURITY - JWT
# ============================================
# IMPORTANT: Generate with: openssl rand -hex 32
JWT_SECRET=<GENERATE_64_CHAR_HEX_STRING>
JWT_EXP_HOURS=1
REFRESH_TOKEN_EXP_DAYS=7

# ============================================
# OAUTH 2.0 AUTHENTICATION
# ============================================
# IMPORTANT: Generate with: openssl rand -hex 32
OAUTH_ENCRYPTION_KEY=<GENERATE_64_CHAR_HEX_STRING>
OAUTH_STATE_EXPIRY=10

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Facebook OAuth (get from Facebook Developers)
FACEBOOK_APP_ID=<YOUR_FACEBOOK_APP_ID>
FACEBOOK_APP_SECRET=<YOUR_FACEBOOK_APP_SECRET>
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback

# OAuth Allowed Redirect URIs (comma-separated)
OAUTH_ALLOWED_REDIRECTS=http://localhost:8080/auth/callback

# ============================================
# CORS CONFIGURATION
# ============================================
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ============================================
# ADMIN USER
# ============================================
ADMIN_EMAIL=admin@streetcore.com
# IMPORTANT: Generate strong password with: openssl rand -base64 32
ADMIN_PASSWORD=<GENERATE_STRONG_PASSWORD>
ADMIN_ROLE=admin
ADMIN_NICKNAME=Administrator

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_TO_FILE=true
LOG_FILE_DIR=./backend/logs
LOG_MAX_FILE_SIZE_MB=50
LOG_MAX_AGE_DAYS=30
LOG_TO_MONGO=true
LOG_MONGO_TTL_DAYS=30

# ============================================
# MEDIA STORAGE CONFIGURATION
# ============================================
# Storage type: filesystem | s3 | hybrid
MEDIA_STORAGE_TYPE=filesystem
MEDIA_UPLOAD_DIR=./backend/uploads
MEDIA_MAX_FILE_SIZE_MB=10
MEDIA_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,mp4,mov,avi

# ============================================
# CDN CONFIGURATION (Optional)
# ============================================
MEDIA_CDN_DOMAIN=
MEDIA_CDN_ENABLED=false

# ============================================
# S3 STORAGE (Optional - for production)
# ============================================
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_ENDPOINT=

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_S3_STORAGE=false
FEATURE_HYBRID_STORAGE=false
FEATURE_CDN_ENABLED=false
FEATURE_MIGRATION_ENABLED=false

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_RATE=1000
RATE_LIMIT_GENERAL_WINDOW_MINUTES=60
RATE_LIMIT_AUTH_RATE=10
RATE_LIMIT_AUTH_WINDOW_MINUTES=1
RATE_LIMIT_PASSWORD_RESET_RATE=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_MINUTES=10
RATE_LIMIT_FILE_UPLOAD_RATE=10
RATE_LIMIT_FILE_UPLOAD_WINDOW_MINUTES=1

# ============================================
# TESTING MODE
# ============================================
TESTING_MODE=false

# ============================================
# EMAIL SERVICE (Optional - for production)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@streetcore.com
SMTP_FROM_NAME=StreetCore

# ============================================
# PAYMENT INTEGRATION - STRIPE (Optional)
# ============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# ANALYTICS (Optional)
# ============================================
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=

# ============================================
# ERROR TRACKING (Optional - Sentry)
# ============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============================================
# CACHE CONFIGURATION (Optional - Redis)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# GIT COMMIT (for cache busting)
# ============================================
COMMIT_SHA=dev

# ============================================
# INSTRUCTIONS FOR GENERATING SECRETS
# ============================================
# JWT_SECRET and OAUTH_ENCRYPTION_KEY:
#   openssl rand -hex 32
#
# ADMIN_PASSWORD, MONGO_ROOT_PASSWORD, DB_APP_PASS:
#   openssl rand -base64 32
#
# Example:
#   JWT_SECRET=$(openssl rand -hex 32)
#   echo "JWT_SECRET=$JWT_SECRET"
